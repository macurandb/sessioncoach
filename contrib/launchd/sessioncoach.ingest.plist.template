<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- (`sessioncoach setup` / `sessioncoach ingest-install` generate this for you.) `sessioncoach ingest` every 30 minutes on macOS (cheap: only new records are added). Replace __SESSIONCOACH__ (path to bin/sessioncoach) and __LOG__ (log file),
     copy to ~/Library/LaunchAgents/sessioncoach.ingest.plist, then:
     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/sessioncoach.ingest.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>sessioncoach.ingest</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__SESSIONCOACH__</string>
    <string>ingest</string>
  </array>
  <key>StartInterval</key><integer>1800</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__LOG__</string>
  <key>StandardErrorPath</key><string>__LOG__</string>
  <key>LowPriorityIO</key><true/>
  <key>Nice</key><integer>10</integer>
</dict>
</plist>
